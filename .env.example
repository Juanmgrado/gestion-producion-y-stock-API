# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_DATABASE=postgres

# Server
PORT=5004
# Allowed origin(s) for CORS (your frontend URL). Comma-separate for more than
# one, e.g. your deployed frontend plus localhost for local dev against this API.
CORS_ORIGIN=http://localhost:5173,https://your-deployed-frontend.example.com

# Auth
# Use a long, random string (e.g. `openssl rand -hex 64`)
JWT_SECRET=your_jwt_secret

# Initial admin user password (used for seeding on first boot)
ADMIN_PASSWORD=your_admin_password

# twilio credentials
TWILIO_ACCOUNT_SID=twilio_SID
TWILIO_AUTH_TOKEN=twilio_token
TWILIO_WHATSAPP_FROM=whatsapp:+343149348134
TWILIO_WHATSAPP_TO=whatsapp:+3445314134134
